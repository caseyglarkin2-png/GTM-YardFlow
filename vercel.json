{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/cron/process-queue",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/execute-sequences",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "api/railway/[...path].ts": {
      "maxDuration": 30
    },
    "api/email/webhook.ts": {
      "maxDuration": 30
    },
    "api/cron/process-queue.ts": {
      "maxDuration": 60
    },
    "api/cron/execute-sequences.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/email/webhook",
      "headers": [
        { "key": "x-vercel-raw-body", "value": "true" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/" }
  ]
}
