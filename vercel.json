{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/cron/process-queue",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/execute-sequences",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/aggregate-reputation",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/sync-suppressions",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "lib/**,src/**"
    },
    "api/railway/[...path].ts": {
      "maxDuration": 30,
      "includeFiles": "lib/**,src/**"
    },
    "api/email/webhook.ts": {
      "maxDuration": 30,
      "includeFiles": "lib/**,src/**"
    },
    "api/cron/process-queue.ts": {
      "maxDuration": 60,
      "includeFiles": "lib/**,src/**"
    },
    "api/cron/execute-sequences.ts": {
      "maxDuration": 60,
      "includeFiles": "lib/**,src/**"
    },
    "api/cron/aggregate-reputation.ts": {
      "maxDuration": 60,
      "includeFiles": "lib/**,src/**"
    },
    "api/cron/sync-suppressions.ts": {
      "maxDuration": 60,
      "includeFiles": "lib/**,src/**"
    }
  },
  "headers": [
    {
      "source": "/api/email/webhook",
      "headers": [
        { "key": "x-vercel-raw-body", "value": "true" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/" }
  ]
}
