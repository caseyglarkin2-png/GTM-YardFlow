{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/email/webhook.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/email/webhook",
      "headers": [
        { "key": "x-vercel-raw-body", "value": "true" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ]
}
