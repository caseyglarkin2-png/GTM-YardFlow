{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/email/webhook.ts": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/email/webhook",
      "methods": ["POST"],
      "headers": {
        "x-vercel-raw-body": "true"
      }
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ]
}
