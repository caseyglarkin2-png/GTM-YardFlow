# YardFlow GTM Hub Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# ==============================================================================
# Firebase Configuration (Client-side)
# ==============================================================================
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# ==============================================================================
# Firebase Admin (Server-side only)
# ==============================================================================
# Option 1: Full service account JSON (preferred for Vercel)
# Paste the entire service account JSON as a single line
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Option 2: Just project ID (uses Application Default Credentials)
FIREBASE_PROJECT_ID=your-project-id

# For local development with Firebase Emulator:
# FIRESTORE_EMULATOR_HOST=localhost:8080

# ==============================================================================
# HubSpot OAuth Configuration
# ==============================================================================
# Client-side OAuth settings (safe to expose in browser)
VITE_HUBSPOT_CLIENT_ID=your_hubspot_app_client_id
VITE_HUBSPOT_REDIRECT_URI=https://your-domain.vercel.app/api/oauth/callback

# Server-side only - NEVER expose to frontend!
# These are used by Vercel serverless functions in /api folder
# Add these directly in Vercel Dashboard > Settings > Environment Variables
HUBSPOT_CLIENT_SECRET=server_side_only_never_expose

# Frontend URL for OAuth redirects (auto-detected on Vercel)
VITE_FRONTEND_URL=http://localhost:5173

# ==============================================================================
# Gemini AI (Optional)
# ==============================================================================
# Users can also set this in-app via Settings
VITE_GEMINI_API_KEY=your_gemini_api_key

# ==============================================================================
# SendGrid Email Configuration (Server-side only)
# ==============================================================================
# API key from SendGrid dashboard (Settings > API Keys)
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Verified sender email address
SENDGRID_FROM_EMAIL=notifications@your-domain.com

# Webhook signature verification (Event Webhook > Signing Key)
# This is the public key for verifying webhook signatures
SENDGRID_WEBHOOK_PUBLIC_KEY=MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE...

# ==============================================================================
# Email Tracking & Compliance (Server-side only)
# ==============================================================================
# Secret for signing tracking pixel URLs (generate with: openssl rand -hex 32)
TRACKING_SECRET=your_tracking_secret_32_chars

# Secret for HMAC signing unsubscribe links (generate with: openssl rand -hex 32)
UNSUBSCRIBE_HMAC_SECRET=your_unsubscribe_hmac_secret

# Base URL for tracking pixels and links
# Use your production domain or ngrok URL for testing
TRACKING_BASE_URL=https://your-domain.vercel.app

# Alternative: Use PUBLIC_BASE_URL if TRACKING_BASE_URL is not set
PUBLIC_BASE_URL=https://your-domain.vercel.app

# Physical postal address for CAN-SPAM compliance (required)
COMPLIANCE_POSTAL_ADDRESS=123 Main St, Suite 100, San Francisco, CA 94102

# Support email for unsubscribe confirmations
SUPPORT_EMAIL=support@your-domain.com

# ==============================================================================
# Railway Backend Integration (Recommended for Email)
# ==============================================================================
# The Railway backend at YardFlow-Hitlist has robust email infrastructure:
# - Postgres database with full schema
# - Redis + BullMQ job queues
# - Background worker for async processing
# - Proper sequence automation
#
# Set this to enable Railway as the email backend:
RAILWAY_API_URL=https://yardflow-hitlist-production-2f41.up.railway.app

# Optional: Shared secret for API authentication between Vercel and Railway
# Generate with: openssl rand -hex 32
RAILWAY_API_SECRET=

# Server-to-server authentication secret (must match CRON_SECRET in Railway)
SERVICE_TO_SERVICE_SECRET=your_s2s_secret

# ==============================================================================
# Feature Flags (Client-side - controls Railway migration)
# ==============================================================================
# Master toggle for Railway backend (default: false = use Firestore)
VITE_RAILWAY_ENABLED=false

# Route authentication through Railway/NextAuth (default: false = use Firebase)
VITE_RAILWAY_AUTH_ENABLED=false

# Route email sending through Railway/SendGrid (default: false = use Vercel)
# NOTE: Railway email requires NextAuth session. Keep false for Firebase auth.
VITE_RAILWAY_EMAIL_ENABLED=false

# Route data operations through Railway Postgres (default: false = use Firestore)
VITE_RAILWAY_DATA_ENABLED=false

# Traffic percentage for gradual Railway rollout (0-100, default: 0)
VITE_RAILWAY_TRAFFIC_PERCENT=0

# Enable dual-write to both Firestore and Railway (safety during migration)
VITE_DUAL_WRITE_ENABLED=true

# Enable fallback to Firebase auth if Railway auth fails
VITE_FIREBASE_AUTH_FALLBACK=true

# Debug logging for Railway requests
VITE_DEBUG_RAILWAY_REQUESTS=false

# ==============================================================================
# HubSpot OAuth Setup Instructions
# ==============================================================================
# 1. Go to https://developers.hubspot.com/ and create an app
# 2. In your app settings, add OAuth redirect URI:
#    - Development: http://localhost:5173/api/oauth/callback
#    - Production: https://your-domain.vercel.app/api/oauth/callback
# 3. Copy Client ID to VITE_HUBSPOT_CLIENT_ID
# 4. Copy Client Secret to HUBSPOT_CLIENT_SECRET (Vercel env vars only!)
# 5. Required scopes for YardFlow:
#    - crm.objects.contacts.read
#    - crm.objects.contacts.write
#    - crm.objects.deals.read
#    - crm.objects.deals.write
#
# IMPORTANT: Never expose HUBSPOT_CLIENT_SECRET to the frontend!
# The VITE_ prefix automatically makes vars available to the browser.
# Server-side secrets should NOT have the VITE_ prefix.

# ==============================================================================
# SendGrid Setup Instructions
# ==============================================================================
# 1. Create a SendGrid account at https://sendgrid.com
# 2. Verify your sender domain (Settings > Sender Authentication)
# 3. Create an API key with "Mail Send" permissions (Settings > API Keys)
# 4. Set up Event Webhook for delivery tracking:
#    - Settings > Mail Settings > Event Webhook
#    - HTTP POST URL: https://your-domain.vercel.app/api/email/webhook
#    - Enable: Delivered, Opened, Clicked, Bounced, Spam Reports, Unsubscribes
#    - Enable "Signed Event Webhook" and copy the public key
# 5. Add environment variables to Vercel Dashboard
